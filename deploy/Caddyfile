# Caddy reverse proxy for AutoGLM-GUI.
#
# 1. Replace app.example.com with your domain (DNS A/AAAA record required).
# 2. Generate a password hash:
#      caddy hash-password --plaintext 'your-strong-password'
#    and paste it into the basic_auth block below.
# 3. Run: caddy run --config deploy/Caddyfile
#
# Caddy obtains and renews TLS certificates automatically.

{
	email admin@example.com
}

app.example.com {
	encode zstd gzip

	# Protect the whole web UI and API. The internal system uses the
	# /api/ingest/* endpoints with X-API-Key auth, so it does not need this
	# basic-auth credential - see deploy/INTEGRATION.md.
	basic_auth {
		admin $2a$14$REPLACE_WITH_CADDY_HASH_PASSWORD
	}

	# SSE task streaming and Socket.IO video need long-lived connections.
	reverse_proxy 127.0.0.1:8000 {
		flush_interval -1
	}
}