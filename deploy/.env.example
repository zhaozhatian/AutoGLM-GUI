# Copy to deploy/.env and fill in real values.

AUTOGLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
AUTOGLM_MODEL_NAME=autoglm-phone
AUTOGLM_API_KEY=

# Long random value shared with the internal system (X-API-Key).
AUTOGLM_INGEST_TOKEN=

# Long random value used to sign webhook callbacks.
AUTOGLM_WEBHOOK_SECRET=

# Optional comma-separated allowlist for callback hosts.
AUTOGLM_WEBHOOK_ALLOWED_HOSTS=

AUTOGLM_PUSH_TIMEZONE=Asia/Shanghai
TZ=Asia/Shanghai

# Optional: point at an external adb server (Mac mini / another host).
# Leave empty to use the container's own adb server and the GUI "配对并连接"
# dialog with the phone's Tailscale IP.
ADB_SERVER_SOCKET=

# Linux platform-tools on the ECS host, mounted into the container.
# Download the same version as the Mac mini:
#   curl -o /tmp/pt.zip https://dl.google.com/android/repository/platform-tools-latest-linux.zip
#   unzip -q /tmp/pt.zip -d /opt
PLATFORM_TOOLS_DIR=/opt/platform-tools
AUTOGLM_ADB_PATH=/opt/platform-tools/adb

# Browser origins allowed to call the GUI API.
AUTOGLM_CORS_ORIGINS=https://app.example.com