# Copy to deploy/.env and fill in real values.

AUTOGLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
AUTOGLM_MODEL_NAME=autoglm-phone
AUTOGLM_API_KEY=

# Long random value shared with the internal system (X-API-Key).
AUTOGLM_INGEST_TOKEN=

# Long random value used to sign webhook callbacks.
AUTOGLM_WEBHOOK_SECRET=

# Optional comma-separated allowlist for callback hosts.
AUTOGLM_WEBHOOK_ALLOWED_HOSTS=

AUTOGLM_PUSH_TIMEZONE=Asia/Shanghai
TZ=Asia/Shanghai

# Browser origins allowed to call the GUI API.
AUTOGLM_CORS_ORIGINS=https://app.example.com